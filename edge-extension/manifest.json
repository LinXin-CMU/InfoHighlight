{
  "manifest_version": 3,
  "name": "InfoLens Local Reader",
  "version": "0.8.19",
  "description": "Local GPU information highlights. No cloud fallback.",
  "key": "",
  "permissions": [
    "activeTab",
    "scripting",
    "nativeMessaging",
    "storage"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    },
    "default_popup": "popup.html",
    "default_title": "InfoLens Local"
  },
  "minimum_chrome_version": "106",
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ]
}
